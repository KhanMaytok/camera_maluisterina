# Servidor
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/grabadora.db
MEDIA_DIR=./data/media
CORS_ORIGINS=*

# Auth (genera valores largos y aleatorios)
JWT_SECRET=change-me
REFRESH_SECRET=change-me-too
ACCESS_TTL=1h
REFRESH_TTL_DAYS=30

# Storage S3-compatible (R2 o B2). En desarrollo dejar STORAGE_ENABLED=false
# para usar almacenamiento local temporal en /api/uploads/dev.
STORAGE_ENABLED=false
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_TLS_INSECURE=false
S3_BUCKET_CLIPS=grabadora-clips
S3_BUCKET_THUMBS=grabadora-thumbs

# Push (Web Push para el visor PWA; FCM opcional para apps nativas)
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@grabadora.local
FCM_PROJECT=
FCM_SERVICE_ACCOUNT=

# WebRTC (STUN público por defecto; TURN opcional)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Retención y limpieza
RETENTION_CHECK_MINUTES=60
